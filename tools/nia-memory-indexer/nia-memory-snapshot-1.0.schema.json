{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nia.local/schemas/nia-memory-snapshot-1.0.schema.json",
  "title": "NIA Memory Snapshot 1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format", "schema_version", "snapshot_id", "created_at_epoch_ms",
    "source", "record_count", "hash_algorithm", "records_hash", "records"
  ],
  "properties": {
    "format": { "const": "nia-memory-snapshot" },
    "schema_version": { "const": "1.0.0" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "created_at_epoch_ms": { "type": "integer", "minimum": 0 },
    "source_generation": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "required": ["system"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "device_role": { "type": "string" }
      },
      "additionalProperties": true
    },
    "record_count": { "type": "integer", "minimum": 0 },
    "hash_algorithm": { "const": "SHA-256" },
    "records_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "key", "content", "createdAt", "updatedAt", "category", "hitCount",
          "source", "id", "receiptStatus", "claimStatus", "factStatus",
          "resolutionStatus", "sourceConversationId", "provenance"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "createdAt": { "type": "integer", "minimum": 0 },
          "updatedAt": { "type": "integer", "minimum": 0 },
          "category": { "enum": ["GENERAL", "LEARNING", "ERROR", "PREFERENCE"] },
          "hitCount": { "type": "integer", "minimum": 0 },
          "source": { "type": ["string", "null"] },
          "id": { "type": "string", "minLength": 1 },
          "receiptStatus": { "$ref": "#/$defs/assessment" },
          "claimStatus": { "$ref": "#/$defs/assessment" },
          "factStatus": { "$ref": "#/$defs/assessment" },
          "resolutionStatus": { "$ref": "#/$defs/assessment" },
          "sourceConversationId": { "type": ["string", "null"] },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["source", "conversationId", "observedAt"],
              "properties": {
                "source": { "type": ["string", "null"] },
                "conversationId": { "type": ["string", "null"] },
                "observedAt": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "assessment": {
      "enum": ["CONFIRMED", "REPORTED", "ASSUMED", "UNKNOWN", "NEEDS_VERIFICATION"]
    }
  }
}