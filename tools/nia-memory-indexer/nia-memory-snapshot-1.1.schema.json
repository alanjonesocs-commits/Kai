{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nia.local/schemas/nia-memory-snapshot-1.1.schema.json",
  "title": "NIA Memory Snapshot 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "snapshot_id", "created_at_epoch_ms", "source",
    "source_generation", "generation_authority", "record_count", "records",
    "records_hash", "hash_scope", "envelope_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "snapshot_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "created_at_epoch_ms": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "source_generation": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        { "type": "null" }
      ]
    },
    "generation_authority": { "type": ["string", "null"], "pattern": "\\S" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "platform", "device_label", "system"],
      "properties": {
        "application": { "type": "string", "pattern": "\\S" },
        "platform": { "type": "string", "pattern": "\\S" },
        "device_label": { "type": ["string", "null"] },
        "system": { "type": "string", "pattern": "\\S" }
      }
    },
    "record_count": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "key", "content", "createdAt", "updatedAt", "category", "hitCount",
          "source", "id", "receiptStatus", "claimStatus", "factStatus",
          "resolutionStatus", "sourceConversationId", "provenance"
        ],
        "properties": {
          "key": { "type": "string", "pattern": "\\S" },
          "content": { "type": "string" },
          "createdAt": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "updatedAt": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "category": { "enum": ["GENERAL", "LEARNING", "ERROR", "PREFERENCE"] },
          "hitCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
          "source": { "type": ["string", "null"] },
          "id": { "type": "string", "pattern": "\\S" },
          "receiptStatus": { "$ref": "#/$defs/assessment" },
          "claimStatus": { "$ref": "#/$defs/assessment" },
          "factStatus": { "$ref": "#/$defs/assessment" },
          "resolutionStatus": { "$ref": "#/$defs/assessment" },
          "sourceConversationId": { "type": ["string", "null"] },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["source", "conversationId", "observedAt"],
              "properties": {
                "source": { "type": ["string", "null"] },
                "conversationId": { "type": ["string", "null"] },
                "observedAt": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
              }
            }
          }
        }
      }
    },
    "records_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hash_scope": { "const": "snapshot-envelope-v1" },
    "envelope_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "assessment": {
      "enum": ["CONFIRMED", "REPORTED", "ASSUMED", "UNKNOWN", "NEEDS_VERIFICATION"]
    }
  }
}
